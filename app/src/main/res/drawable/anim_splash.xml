<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_folder">

    <!-- the flower blooms: petals turn a little and open up -->
    <target android:name="petals">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:duration="800" android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation" android:valueFrom="-40" android:valueTo="0" android:valueType="floatType" />
                <objectAnimator android:duration="800" android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1" android:valueType="floatType" />
                <objectAnimator android:duration="800" android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
